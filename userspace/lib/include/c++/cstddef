#pragma once

#include <stddef.h>

namespace std {

    /* ptrdiff_t */
    using ptrdiff_t = ::ptrdiff_t;

    /* size_t */
    using size_t = ::size_t;

    /* wchar_t — built-in keyword in C++, no typedef needed */

    /* wint_t */
    using wint_t = ::wint_t;

    /* nullptr_t */
    using nullptr_t = decltype(nullptr);

    /* max_align_t — type whose alignment is at least as large as every scalar */
    using max_align_t = long double;

} // namespace std

#if __cplusplus >= 201703L

namespace std {

    enum class byte : unsigned char {};

    // Shift operators
    template<typename IntType>
    [[nodiscard]] constexpr byte operator<<(byte b, IntType shift) noexcept {
        return static_cast<byte>(static_cast<unsigned char>(
            static_cast<unsigned int>(b) << shift));
    }

    template<typename IntType>
    [[nodiscard]] constexpr byte operator>>(byte b, IntType shift) noexcept {
        return static_cast<byte>(static_cast<unsigned char>(
            static_cast<unsigned int>(b) >> shift));
    }

    template<typename IntType>
    constexpr byte& operator<<=(byte& b, IntType shift) noexcept {
        return b = b << shift;
    }

    template<typename IntType>
    constexpr byte& operator>>=(byte& b, IntType shift) noexcept {
        return b = b >> shift;
    }

    // Bitwise operators
    [[nodiscard]] constexpr byte operator|(byte l, byte r) noexcept {
        return static_cast<byte>(static_cast<unsigned char>(
            static_cast<unsigned int>(l) | static_cast<unsigned int>(r)));
    }

    [[nodiscard]] constexpr byte operator&(byte l, byte r) noexcept {
        return static_cast<byte>(static_cast<unsigned char>(
            static_cast<unsigned int>(l) & static_cast<unsigned int>(r)));
    }

    [[nodiscard]] constexpr byte operator^(byte l, byte r) noexcept {
        return static_cast<byte>(static_cast<unsigned char>(
            static_cast<unsigned int>(l) ^ static_cast<unsigned int>(r)));
    }

    [[nodiscard]] constexpr byte operator~(byte b) noexcept {
        return static_cast<byte>(static_cast<unsigned char>(
            ~static_cast<unsigned int>(b)));
    }

    constexpr byte& operator|=(byte& l, byte r) noexcept { return l = l | r; }
    constexpr byte& operator&=(byte& l, byte r) noexcept { return l = l & r; }
    constexpr byte& operator^=(byte& l, byte r) noexcept { return l = l ^ r; }

    // to_integer<T> — explicit cast to integral type
    template<typename IntType>
    [[nodiscard]] constexpr IntType to_integer(byte b) noexcept {
        return static_cast<IntType>(b);
    }

} // namespace std

#endif // __cplusplus >= 201703L
