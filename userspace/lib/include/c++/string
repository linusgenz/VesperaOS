// ============================================================
// Non-member comparison operators
// ============================================================

template<typename C, typename T, typename A>
[[nodiscard]] bool operator==(const basic_string<C,T,A>& a,
                               const basic_string<C,T,A>& b) noexcept {
    return a.size() == b.size() && a.compare(b) == 0;
}
template<typename C, typename T, typename A>
[[nodiscard]] bool operator!=(const basic_string<C,T,A>& a,
                               const basic_string<C,T,A>& b) noexcept {
    return !(a == b);
}
template<typename C, typename T, typename A>
[[nodiscard]] bool operator<(const basic_string<C,T,A>& a,
                              const basic_string<C,T,A>& b) noexcept {
    return a.compare(b) < 0;
}
template<typename C, typename T, typename A>
[[nodiscard]] bool operator<=(const basic_string<C,T,A>& a,
                               const basic_string<C,T,A>& b) noexcept {
    return a.compare(b) <= 0;
}
template<typename C, typename T, typename A>
[[nodiscard]] bool operator>(const basic_string<C,T,A>& a,
                              const basic_string<C,T,A>& b) noexcept {
    return a.compare(b) > 0;
}
template<typename C, typename T, typename A>
[[nodiscard]] bool operator>=(const basic_string<C,T,A>& a,
                               const basic_string<C,T,A>& b) noexcept {
    return a.compare(b) >= 0;
}

// Comparisons with const CharT* (implicit string_view conversion handles
// string_view comparisons via the non-member operators above).
template<typename C, typename T, typename A>
[[nodiscard]] bool operator==(const basic_string<C,T,A>& a,
                               const C* b) noexcept {
    return a.compare(b) == 0;
}
template<typename C, typename T, typename A>
[[nodiscard]] bool operator==(const C* a,
                               const basic_string<C,T,A>& b) noexcept {
    return b.compare(a) == 0;
}
template<typename C, typename T, typename A>
[[nodiscard]] bool operator!=(const basic_string<C,T,A>& a, const C* b) noexcept { return !(a == b); }
template<typename C, typename T, typename A>
[[nodiscard]] bool operator!=(const C* a, const basic_string<C,T,A>& b) noexcept { return !(a == b); }
template<typename C, typename T, typename A>
[[nodiscard]] bool operator< (const basic_string<C,T,A>& a, const C* b) noexcept { return a.compare(b) <  0; }
template<typename C, typename T, typename A>
[[nodiscard]] bool operator< (const C* a, const basic_string<C,T,A>& b) noexcept { return b.compare(a) >  0; }
template<typename C, typename T, typename A>
[[nodiscard]] bool operator<=(const basic_string<C,T,A>& a, const C* b) noexcept { return a.compare(b) <= 0; }
template<typename C, typename T, typename A>
[[nodiscard]] bool operator>=(const basic_string<C,T,A>& a, const C* b) noexcept { return a.compare(b) >= 0; }

// Comparisons with basic_string_view on either side
template<typename C, typename T, typename A>
[[nodiscard]] bool operator==(const basic_string<C,T,A>& a,
                               basic_string_view<C,T> b) noexcept {
    return basic_string_view<C,T>(a) == b;
}
template<typename C, typename T, typename A>
[[nodiscard]] bool operator==(basic_string_view<C,T> a,
                               const basic_string<C,T,A>& b) noexcept {
    return a == basic_string_view<C,T>(b);
}
template<typename C, typename T, typename A>
[[nodiscard]] bool operator!=(const basic_string<C,T,A>& a,
                               basic_string_view<C,T> b) noexcept { return !(a == b); }
template<typename C, typename T, typename A>
[[nodiscard]] bool operator!=(basic_string_view<C,T> a,
                               const basic_string<C,T,A>& b) noexcept { return !(a == b); }
template<typename C, typename T, typename A>
[[nodiscard]] bool operator<(const basic_string<C,T,A>& a,
                              basic_string_view<C,T> b) noexcept {
    return basic_string_view<C,T>(a).compare(b) < 0;
}
template<typename C, typename T, typename A>
[[nodiscard]] bool operator<=(const basic_string<C,T,A>& a,
                               basic_string_view<C,T> b) noexcept {
    return basic_string_view<C,T>(a).compare(b) <= 0;
}
template<typename C, typename T, typename A>
[[nodiscard]] bool operator>(const basic_string<C,T,A>& a,
                              basic_string_view<C,T> b) noexcept {
    return basic_string_view<C,T>(a).compare(b) > 0;
}
template<typename C, typename T, typename A>
[[nodiscard]] bool operator>=(const basic_string<C,T,A>& a,
                               basic_string_view<C,T> b) noexcept {
    return basic_string_view<C,T>(a).compare(b) >= 0;
}

// ============================================================
// Non-member operator+
// ============================================================

template<typename C, typename T, typename A>
[[nodiscard]] basic_string<C,T,A>
operator+(const basic_string<C,T,A>& a, const basic_string<C,T,A>& b) {
    basic_string<C,T,A> r;
    r.reserve(a.size() + b.size());
    r.append(a);
    r.append(b);
    return r;
}

template<typename C, typename T, typename A>
[[nodiscard]] basic_string<C,T,A>
operator+(basic_string<C,T,A>&& a, const basic_string<C,T,A>& b) {
    a.append(b);
    return std::move(a);
}

template<typename C, typename T, typename A>
[[nodiscard]] basic_string<C,T,A>
operator+(const basic_string<C,T,A>& a, basic_string<C,T,A>&& b) {
    b.insert(0, a);
    return std::move(b);
}

template<typename C, typename T, typename A>
[[nodiscard]] basic_string<C,T,A>
operator+(basic_string<C,T,A>&& a, basic_string<C,T,A>&& b) {
    a.append(b);
    return std::move(a);
}

template<typename C, typename T, typename A>
[[nodiscard]] basic_string<C,T,A>
operator+(const C* a, const basic_string<C,T,A>& b) {
    basic_string<C,T,A> r(a);
    r.append(b);
    return r;
}

template<typename C, typename T, typename A>
[[nodiscard]] basic_string<C,T,A>
operator+(const basic_string<C,T,A>& a, const C* b) {
    basic_string<C,T,A> r(a);
    r.append(b);
    return r;
}

template<typename C, typename T, typename A>
[[nodiscard]] basic_string<C,T,A>
operator+(C c, const basic_string<C,T,A>& b) {
    basic_string<C,T,A> r(1, c);
    r.append(b);
    return r;
}

template<typename C, typename T, typename A>
[[nodiscard]] basic_string<C,T,A>
operator+(const basic_string<C,T,A>& a, C c) {
    basic_string<C,T,A> r(a);
    r.push_back(c);
    return r;
}

// ── Non-member swap ───────────────────────────────────────────────────────────

template<typename C, typename T, typename A>
void swap(basic_string<C,T,A>& a, basic_string<C,T,A>& b) noexcept {
    a.swap(b);
}

