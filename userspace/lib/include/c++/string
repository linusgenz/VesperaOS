// Provides:
//   basic_string<CharT, Traits, Allocator>
//   string    (= basic_string<char>)
//   wstring   (= basic_string<wchar_t>)
//   u16string (= basic_string<char16_t>)
//   u32string (= basic_string<char32_t>)
//   hash<string>
//   Comparison operators (==, !=, <, <=, >, >=)
//   operator+ overloads
//   Literal operator ""s

#pragma once

#include <cstddef>
#include <cstdlib>
#include <cstring>
#include <memory>
#include <iterator>
#include <type_traits>
#include <utility>
#include <functional>
