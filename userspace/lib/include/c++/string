// ============================================================
// hash<string>
// ============================================================

template<>
struct hash<string> {
    size_t operator()(const string& s) const noexcept {
        return _hash_detail::_fnv1a(s.data(), s.size());
    }
};

template<>
struct hash<wstring> {
    size_t operator()(const wstring& s) const noexcept {
        return _hash_detail::_fnv1a(s.data(), s.size() * sizeof(wchar_t));
    }
};

template<>
struct hash<u16string> {
    size_t operator()(const u16string& s) const noexcept {
        return _hash_detail::_fnv1a(s.data(), s.size() * sizeof(char16_t));
    }
};

template<>
struct hash<u32string> {
    size_t operator()(const u32string& s) const noexcept {
        return _hash_detail::_fnv1a(s.data(), s.size() * sizeof(char32_t));
    }
};

