// ═════════════════════════════════════════════════════════════════════════════
//  _detail: Red-Black Tree node
// ═════════════════════════════════════════════════════════════════════════════

namespace _detail {

enum class rb_color { red, black };

template<typename Value>
struct map_node {
    Value value;
    map_node* parent = nullptr;
    map_node* left = nullptr;
    map_node* right = nullptr;
    rb_color color = rb_color::red;

    template<typename... Args>
    explicit map_node(Args&&... args)
        : value(forward<Args>(args)...) {}
};

} // namespace _detail

// ═════════════════════════════════════════════════════════════════════════════
//  map_iterator
// ═════════════════════════════════════════════════════════════════════════════

template<typename Value, bool Const>
class map_iterator {
public:
    using value_type        = Value;
    using difference_type   = ptrdiff_t;
    using iterator_category = bidirectional_iterator_tag;
    using pointer           = conditional_t<Const, const Value*, Value*>;
    using reference         = conditional_t<Const, const Value&, Value&>;

private:
    using node_type = _detail::map_node<remove_const_t<Value>>;

    node_type* node_ = nullptr;
    node_type* const* root_ = nullptr;

public:
    map_iterator() noexcept = default;

    map_iterator(node_type* node, node_type* const* root) noexcept
        : node_(node)
        , root_(root) {}

    // iterator -> const_iterator conversion
    template<bool OtherConst, typename = enable_if_t<Const && !OtherConst>>
    map_iterator(const map_iterator<Value, OtherConst>& other) noexcept
        : node_(other.node_raw())
        , root_(other.root_raw()) {}

    [[nodiscard]] reference operator*() const { return node_->value; }
    [[nodiscard]] pointer operator->() const { return &node_->value; }

    map_iterator& operator++() {
        if (!node_) return *this;
        if (node_->right) {
            node_ = node_->right;
            while (node_->left) node_ = node_->left;
        } else {
            node_type* p = node_->parent;
            while (p && node_ == p->right) {
                node_ = p;
                p = p->parent;
            }
            node_ = p;
        }
        return *this;
    }

    map_iterator operator++(int) {
        map_iterator tmp(*this);
        ++(*this);
        return tmp;
    }

    map_iterator& operator--() {
        if (!node_) {
            // Decrementing end() yields the rightmost node
            node_ = *root_;
            if (node_) {
                while (node_->right) node_ = node_->right;
            }
            return *this;
        }
        if (node_->left) {
            node_ = node_->left;
            while (node_->right) node_ = node_->right;
        } else {
            node_type* p = node_->parent;
            while (p && node_ == p->left) {
                node_ = p;
                p = p->parent;
            }
            node_ = p;
        }
        return *this;
    }

    map_iterator operator--(int) {
        map_iterator tmp(*this);
        --(*this);
        return tmp;
    }

    template<bool OtherConst>
    [[nodiscard]] bool operator==(const map_iterator<Value, OtherConst>& other) const {
        return node_ == other.node_raw();
    }

    template<bool OtherConst>
    [[nodiscard]] bool operator!=(const map_iterator<Value, OtherConst>& other) const {
        return node_ != other.node_raw();
    }

    [[nodiscard]] node_type* node_raw() const { return node_; }
    [[nodiscard]] node_type* const* root_raw() const { return root_; }

    template<typename, typename, typename, typename>
    friend class map;
};

// ═════════════════════════════════════════════════════════════════════════════
//  map<Key, T, Compare, Allocator>
// ═════════════════════════════════════════════════════════════════════════════

template<typename Key,
         typename T,
         typename Compare = less<Key>,
         typename Allocator = allocator<pair<const Key, T>>>
class map {
public:
    using key_type        = Key;
    using mapped_type     = T;
    using value_type      = pair<const Key, T>;
    using key_compare     = Compare;
    using allocator_type  = Allocator;

    class value_compare {
        friend class map;
    protected:
        Compare comp;
        value_compare(Compare c) : comp(c) {}
    public:
        bool operator()(const value_type& lhs, const value_type& rhs) const {
            return comp(lhs.first, rhs.first);
        }
    };

    using reference       = value_type&;
    using const_reference = const value_type&;
    using pointer         = typename allocator_traits<Allocator>::pointer;
    using const_pointer   = typename allocator_traits<Allocator>::const_pointer;
    using size_type       = size_t;
    using difference_type = ptrdiff_t;

    using iterator        = map_iterator<value_type, false>;
    using const_iterator  = map_iterator<value_type, true>;

private:
    using node_type = _detail::map_node<value_type>;

    using node_allocator_type = typename Allocator::template rebind<node_type>::other;
    using node_alloc_traits   = allocator_traits<node_allocator_type>;

    node_type* root_ = nullptr;
    size_type element_count_ = 0;
    [[no_unique_address]] Compare comp_{};
    [[no_unique_address]] node_allocator_type node_alloc_{};

    // ── helpers ───────────────────────────────────────────────────────────────

    template<typename... Args>
    [[nodiscard]] node_type* allocate_node(Args&&... args) {
        node_type* n = node_alloc_traits::allocate(node_alloc_, 1);
        if (n == nullptr)
            return nullptr;
        node_alloc_traits::construct(node_alloc_, n, forward<Args>(args)...);
        return n;
    }

    void deallocate_node(node_type* n) {
        node_alloc_traits::destroy(node_alloc_, n);
        node_alloc_traits::deallocate(node_alloc_, n, 1);
    }

    void clear_recursive(node_type* n) {
        if (!n) return;
        clear_recursive(n->left);
        clear_recursive(n->right);
        deallocate_node(n);
    }

    void rotate_left(node_type* x) {
        node_type* y = x->right;
        x->right = y->left;
        if (y->left)
            y->left->parent = x;
        y->parent = x->parent;
        if (!x->parent)
            root_ = y;
        else if (x == x->parent->left)
            x->parent->left = y;
        else
            x->parent->right = y;
        y->left = x;
        x->parent = y;
    }

    void rotate_right(node_type* x) {
        node_type* y = x->left;
        x->left = y->right;
        if (y->right)
            y->right->parent = x;
        y->parent = x->parent;
        if (!x->parent)
            root_ = y;
        else if (x == x->parent->right)
            x->parent->right = y;
        else
            x->parent->left = y;
        y->right = x;
        x->parent = y;
    }

    void insert_fixup(node_type* z) {
        while (z->parent && z->parent->color == _detail::rb_color::red) {
            if (z->parent == z->parent->parent->left) {
                node_type* y = z->parent->parent->right;
                if (y && y->color == _detail::rb_color::red) {
                    z->parent->color = _detail::rb_color::black;
                    y->color = _detail::rb_color::black;
                    z->parent->parent->color = _detail::rb_color::red;
                    z = z->parent->parent;
                } else {
                    if (z == z->parent->right) {
                        z = z->parent;
                        rotate_left(z);
                    }
                    z->parent->color = _detail::rb_color::black;
                    z->parent->parent->color = _detail::rb_color::red;
                    rotate_right(z->parent->parent);
                }
            } else {
                node_type* y = z->parent->parent->left;
                if (y && y->color == _detail::rb_color::red) {
                    z->parent->color = _detail::rb_color::black;
                    y->color = _detail::rb_color::black;
                    z->parent->parent->color = _detail::rb_color::red;
                    z = z->parent->parent;
                } else {
                    if (z == z->parent->left) {
                        z = z->parent;
                        rotate_right(z);
                    }
                    z->parent->color = _detail::rb_color::black;
                    z->parent->parent->color = _detail::rb_color::red;
                    rotate_left(z->parent->parent);
                }
            }
        }
        root_->color = _detail::rb_color::black;
    }

    void transplant(node_type* u, node_type* v) {
        if (!u->parent)
            root_ = v;
        else if (u == u->parent->left)
            u->parent->left = v;
        else
            u->parent->right = v;
        if (v)
            v->parent = u->parent;
    }

    void erase_fixup(node_type* x, node_type* x_parent) {
        while (x != root_ && (!x || x->color == _detail::rb_color::black)) {
            if (x == x_parent->left) {
                node_type* w = x_parent->right;
                if (w && w->color == _detail::rb_color::red) {
                    w->color = _detail::rb_color::black;
                    x_parent->color = _detail::rb_color::red;
                    rotate_left(x_parent);
                    w = x_parent->right;
                }
                if (!w) break;
                if ((!w->left || w->left->color == _detail::rb_color::black) &&
                    (!w->right || w->right->color == _detail::rb_color::black)) {
                    w->color = _detail::rb_color::red;
                    x = x_parent;
                    x_parent = x->parent;
                } else {
                    if (!w->right || w->right->color == _detail::rb_color::black) {
                        if (w->left) w->left->color = _detail::rb_color::black;
                        w->color = _detail::rb_color::red;
                        rotate_right(w);
                        w = x_parent->right;
                    }
                    w->color = x_parent->color;
                    x_parent->color = _detail::rb_color::black;
                    if (w->right) w->right->color = _detail::rb_color::black;
                    rotate_left(x_parent);
                    x = root_;
                }
            } else {
                node_type* w = x_parent->left;
                if (w && w->color == _detail::rb_color::red) {
                    w->color = _detail::rb_color::black;
                    x_parent->color = _detail::rb_color::red;
                    rotate_right(x_parent);
                    w = x_parent->left;
                }
                if (!w) break;
                if ((!w->right || w->right->color == _detail::rb_color::black) &&
                    (!w->left || w->left->color == _detail::rb_color::black)) {
                    w->color = _detail::rb_color::red;
                    x = x_parent;
                    x_parent = x->parent;
                } else {
                    if (!w->left || w->left->color == _detail::rb_color::black) {
                        if (w->right) w->right->color = _detail::rb_color::black;
                        w->color = _detail::rb_color::red;
                        rotate_left(w);
                        w = x_parent->left;
                    }
                    w->color = x_parent->color;
                    x_parent->color = _detail::rb_color::black;
                    if (w->left) w->left->color = _detail::rb_color::black;
                    rotate_right(x_parent);
                    x = root_;
                }
            }
        }
        if (x) x->color = _detail::rb_color::black;
    }

public:
    // ── construct / destroy / copy ───────────────────────────────────────────

    map() : map(Compare()) {}

    explicit map(const Compare& comp, const Allocator& alloc = Allocator())
        : comp_(comp)
        , node_alloc_(alloc) {}

    explicit map(const Allocator& alloc) : map(Compare(), alloc) {}

    template<typename InputIt>
    map(InputIt first, InputIt last,
        const Compare& comp = Compare(),
        const Allocator& alloc = Allocator())
        : map(comp, alloc) {
        insert(first, last);
    }

    map(const map& other)
        : comp_(other.comp_)
        , node_alloc_(node_alloc_traits::select_on_container_copy_construction(other.node_alloc_)) {
        for (const value_type& kv : other)
            insert(kv);
    }

    map(map&& other) noexcept
        : root_(other.root_)
        , element_count_(other.element_count_)
        , comp_(move(other.comp_))
        , node_alloc_(move(other.node_alloc_)) {
        other.root_ = nullptr;
        other.element_count_ = 0;
    }

    map(initializer_list<value_type> init,
        const Compare& comp = Compare(),
        const Allocator& alloc = Allocator())
        : map(comp, alloc) {
        insert(init.begin(), init.end());
    }

    ~map() { clear(); }

    map& operator=(const map& other) {
        if (this != &other) {
            map tmp(other);
            swap(tmp);
        }
        return *this;
    }

    map& operator=(map&& other) noexcept {
        if (this != &other) {
            clear();
            root_ = other.root_;
            element_count_ = other.element_count_;
            comp_ = move(other.comp_);
            node_alloc_ = move(other.node_alloc_);
            other.root_ = nullptr;
            other.element_count_ = 0;
        }
        return *this;
    }

    map& operator=(initializer_list<value_type> init) {
        clear();
        insert(init.begin(), init.end());
        return *this;
    }

    [[nodiscard]] allocator_type get_allocator() const noexcept { return allocator_type(node_alloc_); }

    // ── size / capacity ───────────────────────────────────────────────────────

    [[nodiscard]] bool empty() const noexcept { return element_count_ == 0; }
    [[nodiscard]] size_type size() const noexcept { return element_count_; }
    [[nodiscard]] size_type max_size() const noexcept { return size_type(-1) / sizeof(node_type); }

    // ── iterators ─────────────────────────────────────────────────────────────

    [[nodiscard]] iterator begin() noexcept {
        node_type* n = root_;
        if (n) while (n->left) n = n->left;
        return iterator(n, &root_);
    }

    [[nodiscard]] const_iterator begin() const noexcept {
        node_type* n = root_;
        if (n) while (n->left) n = n->left;
        return const_iterator(n, &root_);
    }

    [[nodiscard]] const_iterator cbegin() const noexcept { return begin(); }

    [[nodiscard]] iterator end() noexcept { return iterator(nullptr, &root_); }
    [[nodiscard]] const_iterator end() const noexcept { return const_iterator(nullptr, &root_); }
    [[nodiscard]] const_iterator cend() const noexcept { return end(); }

    // ── lookup ────────────────────────────────────────────────────────────────

    [[nodiscard]] iterator find(const key_type& k) {
        node_type* current = root_;
        while (current) {
            if (comp_(k, current->value.first))
                current = current->left;
            else if (comp_(current->value.first, k))
                current = current->right;
            else
                return iterator(current, &root_);
        }
        return end();
    }

    [[nodiscard]] const_iterator find(const key_type& k) const {
        node_type* current = root_;
        while (current) {
            if (comp_(k, current->value.first))
                current = current->left;
            else if (comp_(current->value.first, k))
                current = current->right;
            else
                return const_iterator(current, &root_);
        }
        return end();
    }

    [[nodiscard]] size_type count(const key_type& k) const { return find(k) != end() ? 1 : 0; }
    [[nodiscard]] bool contains(const key_type& k) const { return find(k) != end(); }

    [[nodiscard]] iterator lower_bound(const key_type& k) {
        node_type* current = root_;
        node_type* result = nullptr;
        while (current) {
            if (!comp_(current->value.first, k)) {
                result = current;
                current = current->left;
            } else {
                current = current->right;
            }
        }
        return iterator(result, &root_);
    }

    [[nodiscard]] const_iterator lower_bound(const key_type& k) const {
        node_type* current = root_;
        node_type* result = nullptr;
        while (current) {
            if (!comp_(current->value.first, k)) {
                result = current;
                current = current->left;
            } else {
                current = current->right;
            }
        }
        return const_iterator(result, &root_);
    }

    [[nodiscard]] iterator upper_bound(const key_type& k) {
        node_type* current = root_;
        node_type* result = nullptr;
        while (current) {
            if (comp_(k, current->value.first)) {
                result = current;
                current = current->left;
            } else {
                current = current->right;
            }
        }
        return iterator(result, &root_);
    }

    [[nodiscard]] const_iterator upper_bound(const key_type& k) const {
        node_type* current = root_;
        node_type* result = nullptr;
        while (current) {
            if (comp_(k, current->value.first)) {
                result = current;
                current = current->left;
            } else {
                current = current->right;
            }
        }
        return const_iterator(result, &root_);
    }

    [[nodiscard]] pair<iterator, iterator> equal_range(const key_type& k) {
        return {lower_bound(k), upper_bound(k)};
    }

    [[nodiscard]] pair<const_iterator, const_iterator> equal_range(const key_type& k) const {
        return {lower_bound(k), upper_bound(k)};
    }

    [[nodiscard]] mapped_type& at(const key_type& k) {
        iterator it = find(k);
        assert(it != end() && "map::at: key not found");
        return it->second;
    }

    [[nodiscard]] const mapped_type& at(const key_type& k) const {
        const_iterator it = find(k);
        assert(it != end() && "map::at: key not found");
        return it->second;
    }

    [[nodiscard]] mapped_type& operator[](const key_type& k) {
        iterator it = lower_bound(k);
        if (it != end() && !comp_(k, it->first))
            return it->second;
        return emplace(k, mapped_type()).first->second;
    }

    [[nodiscard]] mapped_type& operator[](key_type&& k) {
        iterator it = lower_bound(k);
        if (it != end() && !comp_(k, it->first))
            return it->second;
        return emplace(move(k), mapped_type()).first->second;
    }

    // ── modifiers ─────────────────────────────────────────────────────────────

    pair<iterator, bool> insert(const value_type& v) { return emplace(v); }
    pair<iterator, bool> insert(value_type&& v) { return emplace(move(v)); }

    template<typename P, typename = enable_if_t<is_constructible_v<value_type, P&&>>>
    pair<iterator, bool> insert(P&& v) {
        return emplace(forward<P>(v));
    }

    template<typename InputIt>
    void insert(InputIt first, InputIt last) {
        for (; first != last; ++first)
            emplace(*first);
    }

    void insert(initializer_list<value_type> init) { insert(init.begin(), init.end()); }

    template<typename... Args>
    pair<iterator, bool> emplace(Args&&... args) {
        value_type tmp(forward<Args>(args)...);

        node_type* parent = nullptr;
        node_type* current = root_;
        bool is_left = false;

        while (current) {
            parent = current;
            if (comp_(tmp.first, current->value.first)) {
                current = current->left;
                is_left = true;
            } else if (comp_(current->value.first, tmp.first)) {
                current = current->right;
                is_left = false;
            } else {
                return {iterator(current, &root_), false}; // Duplicate
            }
        }

        node_type* new_node = allocate_node(move(tmp));
        new_node->parent = parent;
        if (!parent) {
            root_ = new_node;
            new_node->color = _detail::rb_color::black; // Root rule
        } else if (is_left) {
            parent->left = new_node;
        } else {
            parent->right = new_node;
        }

        if (parent) {
            insert_fixup(new_node);
        }
        ++element_count_;
        return {iterator(new_node, &root_), true};
    }

    iterator erase(const_iterator pos) {
        node_type* z = pos.node_raw();
        if (!z) return end();

        iterator next_it(z, &root_);
        ++next_it;

        node_type* y = z;
        _detail::rb_color y_orig_color = y->color;
        node_type* x = nullptr;
        node_type* x_parent = nullptr;

        if (!z->left) {
            x = z->right;
            x_parent = z->parent;
            transplant(z, z->right);
        } else if (!z->right) {
            x = z->left;
            x_parent = z->parent;
            transplant(z, z->left);
        } else {
            y = z->right;
            while (y->left) y = y->left;
            y_orig_color = y->color;
            x = y->right;
            if (y->parent == z) {
                x_parent = y;
            } else {
                x_parent = y->parent;
                transplant(y, y->right);
                y->right = z->right;
                y->right->parent = y;
            }
            transplant(z, y);
            y->left = z->left;
            y->left->parent = y;
            y->color = z->color;
        }

        if (y_orig_color == _detail::rb_color::black)
            erase_fixup(x, x_parent);

        deallocate_node(z);
        --element_count_;
        return next_it;
    }

    iterator erase(const_iterator first, const_iterator last) {
        while (first != last)
            first = erase(first);
        return iterator(first.node_raw(), &root_);
    }

    size_type erase(const key_type& k) {
        iterator it = find(k);
        if (it == end()) return 0;
        erase(it);
        return 1;
    }

    void clear() noexcept {
        clear_recursive(root_);
        root_ = nullptr;
        element_count_ = 0;
    }

    void swap(map& other) noexcept {
        using std::swap;
        swap(root_, other.root_);
        swap(element_count_, other.element_count_);
        swap(comp_, other.comp_);
        swap(node_alloc_, other.node_alloc_);
    }

    // ── observers ─────────────────────────────────────────────────────────────

    [[nodiscard]] key_compare key_comp() const { return comp_; }
    [[nodiscard]] value_compare value_comp() const { return value_compare(comp_); }

    template<typename K, typename V, typename C, typename A>
    friend bool operator==(const map<K, V, C, A>&, const map<K, V, C, A>&);
};

// ═════════════════════════════════════════════════════════════════════════════
//  Non-member functions
// ═════════════════════════════════════════════════════════════════════════════

template<typename Key, typename T, typename Compare, typename Allocator>
void swap(map<Key, T, Compare, Allocator>& a, map<Key, T, Compare, Allocator>& b) noexcept {
    a.swap(b);
}

template<typename Key, typename T, typename Compare, typename Allocator>
[[nodiscard]] bool operator==(const map<Key, T, Compare, Allocator>& a,
                              const map<Key, T, Compare, Allocator>& b) {
    if (a.size() != b.size())
        return false;
    auto it1 = a.begin();
    auto it2 = b.begin();
    while (it1 != a.end()) {
        if (it1->first != it2->first || it1->second != it2->second)
            return false;
        ++it1;
        ++it2;
    }
    return true;
}

template<typename Key, typename T, typename Compare, typename Allocator>
[[nodiscard]] bool operator!=(const map<Key, T, Compare, Allocator>& a,
                              const map<Key, T, Compare, Allocator>& b) {
    return !(a == b);
}

