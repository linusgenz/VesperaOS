// Provides:
//   Iterator category tags
//   iterator_traits<T> (SFINAE-friendly, raw pointer specialisations)
//   iterator<> deprecated base class
//   advance, distance, next, prev
//   begin, end, cbegin, cend, rbegin, rend, crbegin, crend
//   size, empty, data
