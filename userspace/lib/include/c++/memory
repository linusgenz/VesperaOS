// ═════════════════════════════════════════════════════════════════════════════
//  addressof
// ═════════════════════════════════════════════════════════════════════════════

template<typename T>
[[nodiscard]] constexpr T* addressof(T& r) noexcept {
    return __builtin_addressof(r);
}

// Prevent taking the address of an rvalue.
template<typename T>
const T* addressof(const T&&) = delete;

// ═════════════════════════════════════════════════════════════════════════════
//  align
// ═════════════════════════════════════════════════════════════════════════════

/// Advances `ptr` to the next `alignment`-aligned address, consuming `space`.
/// Returns nullptr if there is not enough room.
inline void* align(size_t alignment, size_t size, void*& ptr, size_t& space) noexcept {
    if (size > space)
        return nullptr;

    auto p       = reinterpret_cast<uintptr_t>(ptr);
    auto aligned = (p + alignment - 1u) & ~(alignment - 1u);
    auto adjust  = aligned - p;

    if (adjust > space - size)
        return nullptr;

    space -= adjust;
    return ptr = reinterpret_cast<void*>(aligned);
}

// ═════════════════════════════════════════════════════════════════════════════
//  pointer_traits
// ═════════════════════════════════════════════════════════════════════════════

namespace _detail {
    // Detect Ptr::element_type
    template<typename Ptr, typename = void>
    struct _ptr_element_type { using type = void; };

    template<typename Ptr>
    struct _ptr_element_type<Ptr, void_t<typename Ptr::element_type>> {
        using type = typename Ptr::element_type;
    };

    // Detect Ptr::difference_type, default ptrdiff_t
    template<typename Ptr, typename = void>
    struct _ptr_diff_type { using type = ptrdiff_t; };

    template<typename Ptr>
    struct _ptr_diff_type<Ptr, void_t<typename Ptr::difference_type>> {
        using type = typename Ptr::difference_type;
    };

    // Detect Ptr::pointer_to
    template<typename Ptr, typename Elem, typename = void>
    struct _ptr_has_pointer_to : false_type {};

    template<typename Ptr, typename Elem>
    struct _ptr_has_pointer_to<Ptr, Elem,
        void_t<decltype(Ptr::pointer_to(declval<Elem&>()))>> : true_type {};
} // namespace _detail

/// Primary template — for fancy pointer types.
template<typename Ptr>
struct pointer_traits {
    using pointer         = Ptr;
    using element_type    = typename _detail::_ptr_element_type<Ptr>::type;
    using difference_type = typename _detail::_ptr_diff_type<Ptr>::type;

    template<typename U>
    using rebind = typename Ptr::template rebind<U>;

    static pointer pointer_to(element_type& r)
        noexcept(noexcept(Ptr::pointer_to(r)))
    {
        return Ptr::pointer_to(r);
    }
};

/// Partial specialisation for raw pointers.
template<typename T>
struct pointer_traits<T*> {
    using pointer         = T*;
    using element_type    = T;
    using difference_type = ptrdiff_t;

    template<typename U>
    using rebind = U*;

    [[nodiscard]] static constexpr pointer pointer_to(element_type& r) noexcept {
        return addressof(r);
    }
};

// ═════════════════════════════════════════════════════════════════════════════
//  construct_at / destroy_at / destroy / destroy_n
// ═════════════════════════════════════════════════════════════════════════════

/// Constructs a T in-place at p using placement new.
template<typename T, typename... Args>
constexpr T* construct_at(T* p, Args&&... args)
    noexcept(noexcept(::new(static_cast<void*>(p)) T(forward<Args>(args)...)))
{
    return ::new(static_cast<void*>(p)) T(forward<Args>(args)...);
}

/// Calls the destructor of the object at p.
template<typename T>
constexpr void destroy_at(T* p) noexcept {
    if constexpr (is_array_v<T>) {
        for (auto& elem : *p)
            destroy_at(addressof(elem));
    } else {
        p->~T();
    }
}

/// Destroys [first, last).
template<typename ForwardIt>
constexpr void destroy(ForwardIt first, ForwardIt last) noexcept {
    for (; first != last; ++first)
        destroy_at(addressof(*first));
}

/// Destroys n elements starting at first.
template<typename ForwardIt, typename Size>
constexpr ForwardIt destroy_n(ForwardIt first, Size n) noexcept {
    for (; n > 0; ++first, --n)
        destroy_at(addressof(*first));
    return first;
}

// ═════════════════════════════════════════════════════════════════════════════
//  Uninitialized algorithms
//  (no exception handling — VesperaOS builds with -fno-exceptions)
// ═════════════════════════════════════════════════════════════════════════════

// ── uninitialized_copy ────────────────────────────────────────────────────────

template<typename InputIt, typename ForwardIt>
ForwardIt uninitialized_copy(InputIt first, InputIt last, ForwardIt d_first) {
    for (; first != last; ++d_first, ++first)
        construct_at(addressof(*d_first), *first);
    return d_first;
}

template<typename InputIt, typename Size, typename ForwardIt>
ForwardIt uninitialized_copy_n(InputIt first, Size n, ForwardIt d_first) {
    for (; n > 0; ++d_first, ++first, --n)
        construct_at(addressof(*d_first), *first);
    return d_first;
}

// ── uninitialized_move ────────────────────────────────────────────────────────

template<typename InputIt, typename ForwardIt>
ForwardIt uninitialized_move(InputIt first, InputIt last, ForwardIt d_first) {
    for (; first != last; ++d_first, ++first)
        construct_at(addressof(*d_first), move(*first));
    return d_first;
}

template<typename InputIt, typename Size, typename ForwardIt>
ForwardIt uninitialized_move_n(InputIt first, Size n, ForwardIt d_first) {
    for (; n > 0; ++d_first, ++first, --n)
        construct_at(addressof(*d_first), move(*first));
    return d_first;
}

// ── uninitialized_fill ────────────────────────────────────────────────────────

template<typename ForwardIt, typename T>
void uninitialized_fill(ForwardIt first, ForwardIt last, const T& value) {
    for (; first != last; ++first)
        construct_at(addressof(*first), value);
}

template<typename ForwardIt, typename Size, typename T>
ForwardIt uninitialized_fill_n(ForwardIt first, Size n, const T& value) {
    for (; n > 0; ++first, --n)
        construct_at(addressof(*first), value);
    return first;
}

// ── uninitialized_default_construct ──────────────────────────────────────────
// Default-initialises (potentially indeterminate for trivial types).

template<typename ForwardIt>
void uninitialized_default_construct(ForwardIt first, ForwardIt last) {
    using T = typename iterator_traits<ForwardIt>::value_type;
    for (; first != last; ++first)
        ::new(static_cast<void*>(addressof(*first))) T;
}

template<typename ForwardIt, typename Size>
ForwardIt uninitialized_default_construct_n(ForwardIt first, Size n) {
    using T = typename iterator_traits<ForwardIt>::value_type;
    for (; n > 0; ++first, --n)
        ::new(static_cast<void*>(addressof(*first))) T;
    return first;
}

// ── uninitialized_value_construct ─────────────────────────────────────────────
// Value-initialises (zero-initialises trivial types).

template<typename ForwardIt>
void uninitialized_value_construct(ForwardIt first, ForwardIt last) {
    using T = typename iterator_traits<ForwardIt>::value_type;
    for (; first != last; ++first)
        ::new(static_cast<void*>(addressof(*first))) T();
}

template<typename ForwardIt, typename Size>
ForwardIt uninitialized_value_construct_n(ForwardIt first, Size n) {
    using T = typename iterator_traits<ForwardIt>::value_type;
    for (; n > 0; ++first, --n)
        ::new(static_cast<void*>(addressof(*first))) T();
    return first;
}

// ═════════════════════════════════════════════════════════════════════════════
//  default_delete
// ═════════════════════════════════════════════════════════════════════════════

/// Default deleter for unique_ptr<T> — calls `delete`.
template<typename T>
struct default_delete {
    constexpr default_delete() noexcept = default;

    /// Converting constructor: allows default_delete<Derived> → default_delete<Base>.
    template<typename U, enable_if_t<is_convertible_v<U*, T*>, int> = 0>
    constexpr default_delete(const default_delete<U>&) noexcept {}

    void operator()(T* p) const noexcept {
        static_assert(!is_void_v<T>, "cannot delete pointer to incomplete type");
        static_assert(sizeof(T) > 0, "cannot delete pointer to incomplete type");
        delete p;
    }
};

/// Partial specialisation for arrays — calls `delete[]`.
template<typename T>
struct default_delete<T[]> {
    constexpr default_delete() noexcept = default;

    template<typename U, enable_if_t<is_convertible_v<U(*)[], T(*)[]>, int> = 0>
    constexpr default_delete(const default_delete<U[]>&) noexcept {}

    template<typename U, enable_if_t<is_convertible_v<U(*)[], T(*)[]>, int> = 0>
    void operator()(U* p) const noexcept {
        static_assert(sizeof(T) > 0, "cannot delete pointer to incomplete type");
        delete[] p;
    }
};

// ═════════════════════════════════════════════════════════════════════════════
//  _compressed_pair  (internal — EBO for stateless deleters)
// ═════════════════════════════════════════════════════════════════════════════

namespace _detail {
    /// compressed_pair<First, Second>:
    ///   If First is empty and non-final, it is stored as a base class (EBO),
    ///   so sizeof(compressed_pair) == sizeof(Second).
    template<typename First, typename Second,
             bool _UseEBO = is_empty_v<First> && !is_final_v<First>>
    class _compressed_pair;

    // ── EBO active ────────────────────────────────────────────────────────────
    template<typename First, typename Second>
    class _compressed_pair<First, Second, true> : private First {
        Second _second;
    public:
        constexpr _compressed_pair()
            noexcept(is_nothrow_default_constructible_v<First> &&
                     is_nothrow_default_constructible_v<Second>)
            : First(), _second() {}

        template<typename F, typename S>
        constexpr _compressed_pair(F&& f, S&& s)
            noexcept(is_nothrow_constructible_v<First,  F> &&
                     is_nothrow_constructible_v<Second, S>)
            : First(forward<F>(f)), _second(forward<S>(s)) {}

        constexpr First&        first()       noexcept { return static_cast<First&>(*this); }
        constexpr const First&  first() const noexcept { return static_cast<const First&>(*this); }
        constexpr Second&       second()       noexcept { return _second; }
        constexpr const Second& second() const noexcept { return _second; }
    };

    // ── EBO inactive ──────────────────────────────────────────────────────────
    template<typename First, typename Second>
    class _compressed_pair<First, Second, false> {
        First  _first;
        Second _second;
    public:
        constexpr _compressed_pair()
            noexcept(is_nothrow_default_constructible_v<First> &&
                     is_nothrow_default_constructible_v<Second>)
            : _first(), _second() {}

        template<typename F, typename S>
        constexpr _compressed_pair(F&& f, S&& s)
            noexcept(is_nothrow_constructible_v<First,  F> &&
                     is_nothrow_constructible_v<Second, S>)
            : _first(forward<F>(f)), _second(forward<S>(s)) {}

        constexpr First&        first()       noexcept { return _first; }
        constexpr const First&  first() const noexcept { return _first; }
        constexpr Second&       second()       noexcept { return _second; }
        constexpr const Second& second() const noexcept { return _second; }
    };
} // namespace _detail

// ═════════════════════════════════════════════════════════════════════════════
//  allocator<T>  +  allocator_traits<A>
// ═════════════════════════════════════════════════════════════════════════════

template<typename T>
struct allocator {
    using value_type      = T;
    using size_type       = size_t;
    using difference_type = ptrdiff_t;
    using is_always_equal = true_type;

    // propagation traits — all false (stateless allocator)
    using propagate_on_container_copy_assignment = false_type;
    using propagate_on_container_move_assignment = false_type;
    using propagate_on_container_swap            = false_type;

    constexpr allocator() noexcept = default;

    template<typename U>
    constexpr allocator(const allocator<U>&) noexcept {}

    [[nodiscard]] T* allocate(size_t n) {
        void* p = ::malloc(n * sizeof(T));
        // No exceptions — caller must check for nullptr (or we could panic).
        return static_cast<T*>(p);
    }

    void deallocate(T* p, size_t /* n */) noexcept {
        ::free(p);
    }

    template <typename U>
    struct rebind {
        using other = allocator<U>;
    };

    template<typename U>
    bool operator==(const allocator<U>&) const noexcept { return true; }

    template<typename U>
    bool operator!=(const allocator<U>&) const noexcept { return false; }
};

/// Void specialisation — not allocatable, only useful as a rebind source.
template<>
struct allocator<void> {
    using value_type = void;
};

// ── allocator_traits ──────────────────────────────────────────────────────────

namespace _detail {
    // Detect A::pointer
    template<typename A, typename = void>
    struct _alloc_ptr { using type = typename A::value_type*; };
    template<typename A>
    struct _alloc_ptr<A, void_t<typename A::pointer>> { using type = typename A::pointer; };

    // Detect A::const_pointer
    template<typename A, typename Ptr, typename = void>
    struct _alloc_cptr {
        using type = typename pointer_traits<Ptr>::template rebind<const typename A::value_type>;
    };
    template<typename A, typename Ptr>
    struct _alloc_cptr<A, Ptr, void_t<typename A::const_pointer>> {
        using type = typename A::const_pointer;
    };

    // Detect A::size_type
    template<typename A, typename = void>
    struct _alloc_sz { using type = make_unsigned_t<ptrdiff_t>; };
    template<typename A>
    struct _alloc_sz<A, void_t<typename A::size_type>> { using type = typename A::size_type; };

    // Detect A::difference_type
    template<typename A, typename = void>
    struct _alloc_diff { using type = ptrdiff_t; };
    template<typename A>
    struct _alloc_diff<A, void_t<typename A::difference_type>> {
        using type = typename A::difference_type;
    };

    // Detect A::is_always_equal
    template<typename A, typename = void>
    struct _alloc_eq { using type = typename is_empty<A>::type; };
    template<typename A>
    struct _alloc_eq<A, void_t<typename A::is_always_equal>> {
        using type = typename A::is_always_equal;
    };

    // Detect A::propagate_on_container_copy_assignment
    template<typename A, typename = void>
    struct _alloc_pocca { using type = false_type; };
    template<typename A>
    struct _alloc_pocca<A, void_t<typename A::propagate_on_container_copy_assignment>> {
        using type = typename A::propagate_on_container_copy_assignment;
    };

    // Detect A::propagate_on_container_move_assignment
    template<typename A, typename = void>
    struct _alloc_pocma { using type = false_type; };
    template<typename A>
    struct _alloc_pocma<A, void_t<typename A::propagate_on_container_move_assignment>> {
        using type = typename A::propagate_on_container_move_assignment;
    };

    // Detect A::propagate_on_container_swap
    template<typename A, typename = void>
    struct _alloc_pocs { using type = false_type; };
    template<typename A>
    struct _alloc_pocs<A, void_t<typename A::propagate_on_container_swap>> {
        using type = typename A::propagate_on_container_swap;
    };

    // Detect A::construct — SFINAE via void_t on whether a.construct(p, args...) is valid.
    template<typename A, typename T, typename /* = void */, typename... Args>
    struct _has_construct_impl : false_type {};

    template<typename A, typename T, typename... Args>
    struct _has_construct_impl<A, T,
        void_t<decltype(declval<A&>().construct(declval<T*>(), declval<Args>()...))>,
        Args...> : true_type {};

    template<typename A, typename T, typename... Args>
    struct _has_construct : _has_construct_impl<A, T, void, Args...> {};

    template<typename A, typename T, typename... Args>
    enable_if_t<_has_construct<A, T, Args...>::value>
    _alloc_construct(A& a, T* p, Args&&... args) {
        a.construct(p, forward<Args>(args)...);
    }

    template<typename A, typename T, typename... Args>
    enable_if_t<!_has_construct<A, T, Args...>::value>
    _alloc_construct(A&, T* p, Args&&... args) {
        construct_at(p, forward<Args>(args)...);
    }

    // Detect A::destroy
    template<typename A, typename T, typename = void>
    struct _has_destroy : false_type {};

    template<typename A, typename T>
    struct _has_destroy<A, T,
        void_t<decltype(declval<A&>().destroy(declval<T*>()))>> : true_type {};

    template<typename A, typename T>
    enable_if_t<_has_destroy<A, T>::value>
    _alloc_destroy(A& a, T* p) { a.destroy(p); }

    template<typename A, typename T>
    enable_if_t<!_has_destroy<A, T>::value>
    _alloc_destroy(A&, T* p) { destroy_at(p); }

    // Detect A::max_size
    template<typename A>
    auto _alloc_max_size(const A& a, int) -> decltype(a.max_size()) { return a.max_size(); }

    template<typename A>
    auto _alloc_max_size(const A&, long) {
        using size_type = typename _alloc_sz<A>::type;
        return static_cast<size_type>(-1) / sizeof(typename A::value_type);
    }

    // Detect A::select_on_container_copy_construction
    template<typename A>
    auto _alloc_soccc(const A& a, int)
        -> decltype(a.select_on_container_copy_construction()) {
        return a.select_on_container_copy_construction();
    }

    template<typename A>
    A _alloc_soccc(const A& a, long) { return a; }
} // namespace _detail

template<typename A>
struct allocator_traits {
    using allocator_type  = A;
    using value_type      = typename A::value_type;
    using pointer         = typename _detail::_alloc_ptr<A>::type;
    using const_pointer   = typename _detail::_alloc_cptr<A, pointer>::type;
    using size_type       = typename _detail::_alloc_sz<A>::type;
    using difference_type = typename _detail::_alloc_diff<A>::type;
    using is_always_equal = typename _detail::_alloc_eq<A>::type;

    using propagate_on_container_copy_assignment = typename _detail::_alloc_pocca<A>::type;
    using propagate_on_container_move_assignment = typename _detail::_alloc_pocma<A>::type;
    using propagate_on_container_swap            = typename _detail::_alloc_pocs<A>::type;

    template<typename T>
    using rebind_alloc = typename A::template rebind<T>::other;

    template<typename T>
    using rebind_traits = allocator_traits<rebind_alloc<T>>;

    [[nodiscard]] static pointer allocate(A& a, size_type n) {
        return a.allocate(n);
    }

    static void deallocate(A& a, pointer p, size_type n) noexcept {
        a.deallocate(p, n);
    }

    template<typename T, typename... Args>
    static void construct(A& a, T* p, Args&&... args) {
        _detail::_alloc_construct(a, p, forward<Args>(args)...);
    }

    template<typename T>
    static void destroy(A& a, T* p) {
        _detail::_alloc_destroy(a, p);
    }

    static size_type max_size(const A& a) noexcept {
        return _detail::_alloc_max_size(a, 0);
    }

    static A select_on_container_copy_construction(const A& a) {
        return _detail::_alloc_soccc(a, 0);
    }
};

// ═════════════════════════════════════════════════════════════════════════════
//  unique_ptr<T, D>   (single-object)
// ═════════════════════════════════════════════════════════════════════════════

// Forward declaration of the array specialisation.
template<typename T, typename D>
class unique_ptr;

namespace _detail {
    // Derive the stored pointer type from the deleter, if it defines ::pointer.
    template<typename T, typename D, typename = void>
    struct _uptr_pointer { using type = T*; };

    template<typename T, typename D>
    struct _uptr_pointer<T, D, void_t<typename remove_reference_t<D>::pointer>> {
        using type = typename remove_reference_t<D>::pointer;
    };
} // namespace _detail

template<typename T, typename D = default_delete<T>>
class unique_ptr {
public:
    using element_type  = T;
    using deleter_type  = D;
    using pointer       = typename _detail::_uptr_pointer<T, D>::type;

private:
    _detail::_compressed_pair<D, pointer> _storage;

    pointer&       _ptr()       noexcept { return _storage.second(); }
    const pointer& _ptr() const noexcept { return _storage.second(); }
    D&       _del()       noexcept { return _storage.first(); }
    const D& _del() const noexcept { return _storage.first(); }

public:
    // ── Constructors ──────────────────────────────────────────────────────────

    constexpr unique_ptr() noexcept
        requires (is_default_constructible_v<D> && !is_pointer_v<D>)
        : _storage(D{}, nullptr) {}

    constexpr unique_ptr(nullptr_t) noexcept
        requires (is_default_constructible_v<D> && !is_pointer_v<D>)
        : _storage(D{}, nullptr) {}

    explicit unique_ptr(pointer p) noexcept
        requires (is_default_constructible_v<D> && !is_pointer_v<D>)
        : _storage(D{}, p) {}

    unique_ptr(pointer p, const D& d) noexcept
        requires (!is_reference_v<D>)
        : _storage(d, p) {}

    unique_ptr(pointer p, remove_reference_t<D>&& d) noexcept
        requires (!is_reference_v<D>)
        : _storage(move(d), p) {}

    // lvalue-ref deleter: second ctor takes D& (not D&&)
    unique_ptr(pointer p, D& d) noexcept
        requires (is_lvalue_reference_v<D>)
        : _storage(d, p) {}

    // rvalue ref-to-ref is deleted per [unique.ptr.single.ctor]/p15
    unique_ptr(pointer p, remove_reference_t<D>&& d) noexcept
        requires (is_lvalue_reference_v<D>) = delete;

    // ── Move ──────────────────────────────────────────────────────────────────

    unique_ptr(unique_ptr&& other) noexcept
        : _storage(forward<D>(other._del()), other.release()) {}

    template<typename U, typename E,
             enable_if_t<
                 is_convertible_v<typename unique_ptr<U,E>::pointer, pointer> &&
                 !is_array_v<U> &&
                 (is_reference_v<D>
                     ? is_same_v<D, E>
                     : is_convertible_v<E, D>),
             int> = 0>
    unique_ptr(unique_ptr<U, E>&& other) noexcept
        : _storage(forward<E>(other.get_deleter()), other.release()) {}

    // No copy.
    unique_ptr(const unique_ptr&) = delete;
    unique_ptr& operator=(const unique_ptr&) = delete;

    // ── Destructor ────────────────────────────────────────────────────────────

    ~unique_ptr() noexcept {
        if (_ptr() != nullptr)
            _del()(_ptr());
    }

    // ── Assignment ────────────────────────────────────────────────────────────

    unique_ptr& operator=(unique_ptr&& other) noexcept {
        if (this != &other) {
            reset(other.release());
            _del() = forward<D>(other._del());
        }
        return *this;
    }

    template<typename U, typename E,
             enable_if_t<
                 !is_array_v<U> &&
                 is_convertible_v<typename unique_ptr<U,E>::pointer, pointer> &&
                 is_assignable_v<D&, E&&>,
             int> = 0>
    unique_ptr& operator=(unique_ptr<U, E>&& other) noexcept {
        reset(other.release());
        _del() = forward<E>(other.get_deleter());
        return *this;
    }

    unique_ptr& operator=(nullptr_t) noexcept {
        reset();
        return *this;
    }

    // ── Observers ─────────────────────────────────────────────────────────────

    [[nodiscard]] pointer get() const noexcept { return _ptr(); }

    [[nodiscard]] D&       get_deleter()       noexcept { return _del(); }
    [[nodiscard]] const D& get_deleter() const noexcept { return _del(); }

    [[nodiscard]] explicit operator bool() const noexcept {
        return _ptr() != nullptr;
    }

    [[nodiscard]] add_lvalue_reference_t<T> operator*() const noexcept {
        return *_ptr();
    }

    [[nodiscard]] pointer operator->() const noexcept { return _ptr(); }

    // ── Modifiers ─────────────────────────────────────────────────────────────

    /// Releases ownership without calling the deleter.
    pointer release() noexcept {
        return exchange(_ptr(), nullptr);
    }

    /// Replaces the managed object, deleting the old one.
    void reset(pointer p = pointer{}) noexcept {
        auto old = exchange(_ptr(), p);
        if (old != nullptr)
            _del()(old);
    }

    void swap(unique_ptr& other) noexcept {
        using std::swap;
        swap(_ptr(), other._ptr());
        swap(_del(), other._del());
    }
};

// ═════════════════════════════════════════════════════════════════════════════
//  unique_ptr<T[], D>  (array specialisation)
// ═════════════════════════════════════════════════════════════════════════════

template<typename T, typename D>
class unique_ptr<T[], D> {
public:
    using element_type  = T;
    using deleter_type  = D;
    using pointer       = typename _detail::_uptr_pointer<T, D>::type;

private:
    _detail::_compressed_pair<D, pointer> _storage;

    pointer&       _ptr()       noexcept { return _storage.second(); }
    const pointer& _ptr() const noexcept { return _storage.second(); }
    D&       _del()       noexcept { return _storage.first(); }
    const D& _del() const noexcept { return _storage.first(); }

    // Helpers to restrict which pointer types are acceptable.
    template<typename U>
    using _is_compatible_ptr = bool_constant<
        is_same_v<U, pointer> ||
        is_same_v<U, nullptr_t> ||
        (is_same_v<pointer, element_type*> && is_pointer_v<U> &&
         is_convertible_v<remove_pointer_t<U>(*)[], element_type(*)[]>)>;

public:
    // ── Constructors ──────────────────────────────────────────────────────────

    constexpr unique_ptr() noexcept
        requires (is_default_constructible_v<D> && !is_pointer_v<D>)
        : _storage(D{}, nullptr) {}

    constexpr unique_ptr(nullptr_t) noexcept
        requires (is_default_constructible_v<D> && !is_pointer_v<D>)
        : _storage(D{}, nullptr) {}

    template<typename U, enable_if_t<_is_compatible_ptr<U>::value, int> = 0>
    explicit unique_ptr(U p) noexcept
        requires (is_default_constructible_v<D> && !is_pointer_v<D>)
        : _storage(D{}, p) {}

    template<typename U, enable_if_t<_is_compatible_ptr<U>::value, int> = 0>
    unique_ptr(U p, const D& d) noexcept
        requires (!is_reference_v<D>)
        : _storage(d, p) {}

    template<typename U, enable_if_t<_is_compatible_ptr<U>::value, int> = 0>
    unique_ptr(U p, remove_reference_t<D>&& d) noexcept
        requires (!is_reference_v<D>)
        : _storage(move(d), p) {}

    template<typename U, enable_if_t<_is_compatible_ptr<U>::value, int> = 0>
    unique_ptr(U p, D& d) noexcept
        requires (is_lvalue_reference_v<D>)
        : _storage(d, p) {}

    template<typename U, enable_if_t<_is_compatible_ptr<U>::value, int> = 0>
    unique_ptr(U p, remove_reference_t<D>&&) noexcept
        requires (is_lvalue_reference_v<D>) = delete;

    unique_ptr(unique_ptr&& other) noexcept
        : _storage(forward<D>(other._del()), other.release()) {}

    template<typename U, typename E,
             enable_if_t<
                 is_array_v<U> &&
                 is_same_v<pointer, element_type*> &&
                 is_same_v<typename unique_ptr<U,E>::pointer,
                           typename unique_ptr<U,E>::element_type*> &&
                 is_convertible_v<typename unique_ptr<U,E>::element_type(*)[],
                                  element_type(*)[]> &&
                 (is_reference_v<D>
                     ? is_same_v<E, D>
                     : is_convertible_v<E, D>),
             int> = 0>
    unique_ptr(unique_ptr<U, E>&& other) noexcept
        : _storage(forward<E>(other.get_deleter()), other.release()) {}

    unique_ptr(const unique_ptr&) = delete;
    unique_ptr& operator=(const unique_ptr&) = delete;

    // ── Destructor ────────────────────────────────────────────────────────────

    ~unique_ptr() noexcept {
        if (_ptr() != nullptr)
            _del()(_ptr());
    }

    // ── Assignment ────────────────────────────────────────────────────────────

    unique_ptr& operator=(unique_ptr&& other) noexcept {
        if (this != &other) {
            reset(other.release());
            _del() = forward<D>(other._del());
        }
        return *this;
    }

    unique_ptr& operator=(nullptr_t) noexcept {
        reset();
        return *this;
    }

    // ── Observers ─────────────────────────────────────────────────────────────

    [[nodiscard]] pointer get() const noexcept { return _ptr(); }

    [[nodiscard]] D&       get_deleter()       noexcept { return _del(); }
    [[nodiscard]] const D& get_deleter() const noexcept { return _del(); }

    [[nodiscard]] explicit operator bool() const noexcept {
        return _ptr() != nullptr;
    }

    [[nodiscard]] T& operator[](size_t i) const noexcept { return _ptr()[i]; }

    // ── Modifiers ─────────────────────────────────────────────────────────────

    pointer release() noexcept { return exchange(_ptr(), nullptr); }

    template<typename U = pointer,
             enable_if_t<_is_compatible_ptr<U>::value, int> = 0>
    void reset(U p = U{}) noexcept {
        auto old = exchange(_ptr(), p);
        if (old != nullptr)
            _del()(old);
    }

    void swap(unique_ptr& other) noexcept {
        using std::swap;
        swap(_ptr(), other._ptr());
        swap(_del(), other._del());
    }
};

// ═════════════════════════════════════════════════════════════════════════════
//  make_unique
// ═════════════════════════════════════════════════════════════════════════════

/// make_unique<T>(args...) — for single objects.
template<typename T, typename... Args>
    requires (!is_array_v<T>)
[[nodiscard]] unique_ptr<T> make_unique(Args&&... args) {
    return unique_ptr<T>(new T(forward<Args>(args)...));
}

/// make_unique<T[]>(n) — for arrays of unknown bound.
template<typename T>
    requires (is_array_v<T> && extent_v<T> == 0)
[[nodiscard]] unique_ptr<T> make_unique(size_t n) {
    return unique_ptr<T>(new remove_extent_t<T>[n]());
}

/// make_unique<T[N]> — deleted for arrays of known bound (ill-formed per standard).
template<typename T, typename... Args>
    requires (is_array_v<T> && extent_v<T> != 0)
void make_unique(Args&&...) = delete;

// ── C++20 make_unique_for_overwrite ──────────────────────────────────────────

template<typename T>
    requires (!is_array_v<T>)
[[nodiscard]] unique_ptr<T> make_unique_for_overwrite() {
    return unique_ptr<T>(new T);  // default-initialised, not value-initialised
}

template<typename T>
    requires (is_array_v<T> && extent_v<T> == 0)
[[nodiscard]] unique_ptr<T> make_unique_for_overwrite(size_t n) {
    return unique_ptr<T>(new remove_extent_t<T>[n]);
}

template<typename T, typename... Args>
    requires (is_array_v<T> && extent_v<T> != 0)
void make_unique_for_overwrite(Args&&...) = delete;

// ═════════════════════════════════════════════════════════════════════════════
//  Non-member swap / comparison for unique_ptr
// ═════════════════════════════════════════════════════════════════════════════

template<typename T, typename D>
void swap(unique_ptr<T, D>& a, unique_ptr<T, D>& b) noexcept { a.swap(b); }

template<typename T1, typename D1, typename T2, typename D2>
[[nodiscard]] bool operator==(const unique_ptr<T1,D1>& a,
                               const unique_ptr<T2,D2>& b) noexcept {
    return a.get() == b.get();
}

template<typename T1, typename D1, typename T2, typename D2>
[[nodiscard]] bool operator!=(const unique_ptr<T1,D1>& a,
                               const unique_ptr<T2,D2>& b) noexcept {
    return !(a == b);
}

template<typename T, typename D>
[[nodiscard]] bool operator==(const unique_ptr<T,D>& p, nullptr_t) noexcept {
    return !p;
}

template<typename T, typename D>
[[nodiscard]] bool operator==(nullptr_t, const unique_ptr<T,D>& p) noexcept {
    return !p;
}

template<typename T, typename D>
[[nodiscard]] bool operator!=(const unique_ptr<T,D>& p, nullptr_t) noexcept {
    return static_cast<bool>(p);
}

template<typename T, typename D>
[[nodiscard]] bool operator!=(nullptr_t, const unique_ptr<T,D>& p) noexcept {
    return static_cast<bool>(p);
}

} // namespace std
